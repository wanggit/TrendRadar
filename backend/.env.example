# TrendRadar SaaS Backend - Environment Variables
# Copy this file to .env and fill in the values

# App
DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://trendradar:trendradar@localhost:5432/trendradar

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Global Config (用户不可修改)
AI_MODEL=qwen3.6-plus
AI_API_KEY=
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=5000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
